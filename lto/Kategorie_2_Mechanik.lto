         <question type="MoodleClozeCalc">
            <id>157656152</id>
            <idUser>1836</idUser>
            <questionType>22</questionType>
            <single>2</single>
            <name><![CDATA[Musterbeispiel Fahrzeug bergauf]]></name>
            <punkte>13.0</punkte>
            <penalty/>
            <hidden>0</hidden>
            <tag/>
            <noAutoCorrect>0</noAutoCorrect>
            <usecase>0</usecase>
            <synchronize>0</synchronize>
            <shuffleAnswers>1</shuffleAnswers>
            <answerNumbering><![CDATA[abc]]></answerNumbering>
            <unitGradingType>2</unitGradingType>
            <unitPenalty>0.1</unitPenalty>
            <showUnits>0</showUnits>
            <unitsLeft>0</unitsLeft>
            <maxima><![CDATA[// Implementierung funktioniert nur mit MAXIMA, nicht mit Parser
// vexz(r, F) := r[1] * F[2] - r[2] * F[1]
vexz(r, F) := vget(r,0) * vget(F,1) - vget(r,1) * vget(F,0)

// Null-Vektoren
M0 : [0Nm, 0Nm, 0Nm]
F0 : [0N, 0N, 0N]

// Beträge der Kräfte
FGabs : m * g
FNabs : FGabs * cos(alpha)
FTabs : FGabs * abs(sin(alpha))

// Kraftvektoren der Gewichtskraft
FNvec : [0N, -FNabs, 0N]
FTvec : [-FTabs, 0N, 0N]
FGvec : FNvec + FTvec

// Abstsandsvektoren
rHvec : [-(a+b), 0m, 0m]
rGvec : [-b, c, 0m]

// Kraftvektoren
FVvec : [FVx, FVy, 0N]
FHvec : [0N, FHy, 0N]

// Drehmomentgleichung erfordert Maxima statt Parser
equMz : vexz(rGvec,FGvec) + vexz(rHvec, FHvec) = 0Nm
// Kraftgleichung
equFx : vget(FVvec,0) + vget(FHvec,0) + vget(FGvec,0) = 0N
equFy : vget(FVvec,1) + vget(FHvec,1) + vget(FGvec,1) = 0N

// FHy : solvevalue(equMz, [FHy], [FHy])
FVxsol : solvevalue([equMz, equFx, equFy], [FVx, FVy, FHy], FVx)
FVysol : solvevalue([equMz, equFx, equFy], [FVx, FVy, FHy], FVy)
FHysol : solvevalue([equMz, equFx, equFy], [FVx, FVy, FHy], FHy)

// Rückeinsetzen in Vektoren
FVvec : ev(FVvec, FVx = FVxsol, FVy = FVysol)
FHvec : ev(FHvec, FHy = FHysol)
]]></maxima>
            <maximaAngabe><![CDATA[MaxC0:0Nm;MaxC1:0Nm;MaxC10:0m;MaxC11:0m;MaxC12:0m;MaxC13:0N;MaxC14:0N;MaxC15:0N;MaxC16:0Nm;MaxC17:0N;MaxC18:0N;MaxC2:0Nm;MaxC3:0N;MaxC4:0N;MaxC5:0N;MaxC6:0N;MaxC7:0N;MaxC8:0N;MaxC9:0N;;::;F0:[0N,0N,0N];FGabs:g*m;FGvec:[0N-abs(sin(alpha))*g*m,0N-cos(alpha)*g*m,0N+0N];FHvec:[0N,(0m*0N+0Nm+0N*c+0N*b-b*g*m*cos(alpha)-c*g*m*abs(sin(alpha)))/(-a-b),0N];FHysol:(0m*0N+0Nm+0N*c+0N*b-b*g*m*cos(alpha)-c*g*m*abs(sin(alpha)))/(-a-b);FNabs:cos(alpha)*g*m;FNvec:[0N,-(cos(alpha)*g*m),0N];FTabs:abs(sin(alpha))*g*m;FTvec:[-(abs(sin(alpha))*g*m),0N,0N];FVvec:[0N+g*m*abs(sin(alpha))-0N-0N,(0N*a+c*g*m*abs(sin(alpha))-0m*0N-0Nm-0N*a-0N*b-0N*c-a*g*m*cos(alpha))/(-a-b),0N];FVxsol:0N+g*m*abs(sin(alpha))-0N-0N;FVysol:(0N*a+c*g*m*abs(sin(alpha))-0m*0N-0Nm-0N*a-0N*b-0N*c-a*g*m*cos(alpha))/(-a-b);M0:[0Nm,0Nm,0Nm];equFx:vget([0N-abs(sin(alpha))*g*m,0N-cos(alpha)*g*m,0N+0N],0)+vget([0N,FHy,0N],0)+vget([FVx,FVy,0N],0)=0N;equFy:vget([0N-abs(sin(alpha))*g*m,0N-cos(alpha)*g*m,0N+0N],1)+vget([0N,FHy,0N],1)+vget([FVx,FVy,0N],1)=0N;equMz:vget([-b,c,0m],0)*vget([0N-abs(sin(alpha))*g*m,0N-cos(alpha)*g*m,0N+0N],1)-vget([-b,c,0m],1)*vget([0N-abs(sin(alpha))*g*m,0N-cos(alpha)*g*m,0N+0N],0)-vget([0N,FHy,0N],0)*vget([-b-a,0m,0m],1)+vget([0N,FHy,0N],1)*vget([-b-a,0m,0m],0)=0Nm;rGvec:[-b,c,0m];rHvec:[-b-a,0m,0m];]]></maximaAngabe>
