            <maxima><![CDATA[// Nullvektor
N0 : [0N, 0N, 0N]
// Gewichtskraft
FGabs : m1 * g
FGx : -FGabs * sin(beta)
FGy : -FGabs * cos(beta)
FGvec : [FGx, FGy, 0N]
FGTvec : [FGx, 0N, 0N]
FGNvec : [0N, FGy, 0N]

// Normalkraft
FNvec : -FGNvec
FNabs : vabs(FNvec)

// Externe Kraft 
Fabs : k * mu * FGabs
Fvec : [Fabs, 0N, 0N]

// Haftreibungskraft
FHvec : -FGTvec -Fvec
FHabs : vabs(FHvec)

// Maximale Haftreibungskraft
FHmax : mu * FNabs
]]></maxima>
