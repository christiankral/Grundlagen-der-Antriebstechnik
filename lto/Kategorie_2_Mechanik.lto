            <maxima><![CDATA[alpha : alpha1
beta : alpha4 - alpha1
gamma : alpha3 - alpha4

F1x : F1abs * cos(alpha1)
F1y : F1abs * sin(alpha1)
F2x : F2abs * cos(alpha2)
F2y : F2abs * sin(alpha2)
F3x : F3abs * cos(alpha3)
F3y : F3abs * sin(alpha3)
F4x : F4abs * cos(alpha4)
F4y : F4abs * sin(alpha4)

F1 : [F1x, F1y, 0N]
// F2 : [F2x, F2y, 0N] in Rev 5686 nicht möglich, siehe https://project.letto.at/projects/letto/work_packages/444/
// da alpha2 exakt gleich -90°
F2 : [0N,F2y,0N]
F3 : [F3x, F3y, 0N]
F4 : [F4x, F4y, 0N]
F5 : -F1 - F2 - F3 - F4
F5abs : sqrt(vin(F5,F5))
alpha5 : atan2(F5[2],F5[1])]]></maxima>
