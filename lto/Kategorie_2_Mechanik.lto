            <maxima><![CDATA[a : [ax, 0'm1s-2', 0'm1s-2']
m : m1 + m2
FA : m * a
FAx : vget(FA,0)

// Zugstange (S)
FS : m2 * a
FSx : vget(FS,0)
// Alternative Rechnung
FS : FA - m1 * a
FSx : vget(FS,0)
]]></maxima>
