            <maxima><![CDATA[// Vollzylinder
VV :  ra^2 * %pi * l
mV : rho * VV
JV : mV * ra^2 / 2

// Hohlzylinder
ri : ki * ra
VH : (ra^2 - ri^2) * %pi * l 
mH : rho * VH
JH : mH * (ra^2 + ri^2) / 2

// Punktmasse
mP : ground(mV,2)
rP : ra
JP : mP * rP^2
]]></maxima>
            <maximaAngabe><![CDATA[;::;JH:%pi*l*(ra^2-ki^2*ra^2)*(ki^2*ra^2+ra^2)*rho/2;JP:ra^2*ground(%pi*l*ra^2*rho,2);JV:%pi*l*ra^4*rho/2;VH:%pi*l*(ra^2-ki^2*ra^2);VV:%pi*l*ra^2;mH:%pi*l*(ra^2-ki^2*ra^2)*rho;mP:ground(%pi*l*ra^2*rho,2);mV:%pi*l*ra^2*rho;rP:ra;ri:ki*ra;]]></maximaAngabe>
