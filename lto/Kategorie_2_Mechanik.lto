            <maxima><![CDATA[FBx : -ground(mu * (m2 / 4) * g,3)
FB : [FBx, 0N, 0N]

// Gesamtsystem LKW + Anhänger
m : m1 + m2
FA : [FAx, 0N, 0N]
a : (FA + FB) / m

// Zugstange (S)
FS : m2 * a - FB
// Alternative Rechnung
FS : FA - m1 * a
]]></maxima>
            <maximaAngabe><![CDATA[MaxC0:0N;MaxC1:0N;MaxC2:0N;MaxC3:0N;;::;FA:[FAx,0N,0N];FB:[-ground((g*m2*mu)/4,3),0N,0N];FBx:-ground((g*m2*mu)/4,3);FS:[FAx-(m1*(FAx-ground((g*m2*mu)/4,3)))/(m2+m1),0N-((0N+0N)*m1)/(m2+m1),0N-((0N+0N)*m1)/(m2+m1)];a:[(FAx-ground((g*m2*mu)/4,3))/(m2+m1),(0N+0N)/(m2+m1),(0N+0N)/(m2+m1)];m:m2+m1;]]></maximaAngabe>
