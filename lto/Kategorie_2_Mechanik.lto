            <maxima><![CDATA[// Gesamtlänge
l : l1 + l2 + l3
// Massen
m1 : rho1 * l * d1^2 * %pi / 4 
m2 : rho2 * l2 * (d2^2-d1^2) * %pi / 4

// Massenträgheitsmomente
J1 : 1/2 * m1 * (d1 / 2)^2
J2 : 1/2 * m2 * ((d2 / 2)^2 + (d1 / 2)^2)

Jges : J1 + J2
//1.7586]]></maxima>
            <maximaAngabe><![CDATA[;::;J1:(%pi*d1^4*(l3+l2+l1)*rho1)/32;J2:(%pi*(d2^2/4+d1^2/4)*(d2^2-d1^2)*l2*rho2)/8;Jges:(%pi*(d2^2/4+d1^2/4)*(d2^2-d1^2)*l2*rho2)/8+(%pi*d1^4*(l3+l2+l1)*rho1)/32;l:l3+l2+l1;m1:(%pi*d1^2*(l3+l2+l1)*rho1)/4;m2:(%pi*(d2^2-d1^2)*l2*rho2)/4;]]></maximaAngabe>
