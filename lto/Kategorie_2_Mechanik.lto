9+MaxC7],1)+vget([MaxC12,FRy,MaxC13],1)+vget([FKx,FKy,MaxC14],1)= MaxC17],[FRy,FKx,FKy],FKx)";FKysol:"solvevalue([vget([-b-a,c-d,MaxC11],0)*vget([abs(sin(alpha))*g*m+MaxC6,MaxC8-cos(alpha)*g*m,MaxC9+MaxC7],1)-vget([-b-a,c-d,MaxC11],1)*vget([abs(sin(alpha))*g*m+MaxC6,MaxC8-cos(alpha)*g*m,MaxC9+MaxC7],0)-vget([MaxC12,FRy,MaxC13],0)*vget([-b,-d,MaxC10],1)+vget([MaxC12,FRy,MaxC13],1)*vget([-b,-d,MaxC10],0)= MaxC15,vget([abs(sin(alpha))*g*m+MaxC6,MaxC8-cos(alpha)*g*m,MaxC9+MaxC7],0)+vget([MaxC12,FRy,MaxC13],0)+vget([FKx,FKy,MaxC14],0)= MaxC16,vget([abs(sin(alpha))*g*m+MaxC6,MaxC8-cos(alpha)*g*m,MaxC9+MaxC7],1)+vget([MaxC12,FRy,MaxC13],1)+vget([FKx,FKy,MaxC14],1)= MaxC17],[FRy,FKx,FKy],FKy)";FNabs:cos(alpha)*g*m;FNvec:[0N,-(cos(alpha)*g*m),0N];FRvec:"[MaxC12,solvevalue([vget([-b-a,c-d,MaxC11],0)*vget([abs(sin(alpha))*g*m+MaxC6,MaxC8-cos(alpha)*g*m,MaxC9+MaxC7],1)-vget([-b-a,c-d,MaxC11],1)*vget([abs(sin(alpha))*g*m+MaxC6,MaxC8-cos(alpha)*g*m,MaxC9+MaxC7],0)-vget([MaxC12,FRy,MaxC13],0)*vget([-b,-d,MaxC10],1)+vget([MaxC12,FRy,MaxC13],1)*vget([-b,-d,MaxC10],0)= MaxC15,vget([abs(sin(alpha))*g*m+MaxC6,MaxC8-cos(alpha)*g*m,MaxC9+MaxC7],0)+vget([MaxC12,FRy,MaxC13],0)+vget([FKx,FKy,MaxC14],0)= MaxC16,vget([abs(sin(alpha))*g*m+MaxC6,MaxC8-cos(alpha)*g*m,MaxC9+MaxC7],1)+vget([MaxC12,FRy,MaxC13],1)+vget([FKx,FKy,MaxC14],1)= MaxC17],[FRy,FKx,FKy],FRy),MaxC13]";FRysol:"solvevalue([vget([-b-a,c-d,MaxC11],0)*vget([abs(sin(alpha))*g*m+MaxC6,MaxC8-cos(alpha)*g*m,MaxC9+MaxC7],1)-vget([-b-a,c-d,MaxC11],1)*vget([abs(sin(alpha))*g*m+MaxC6,MaxC8-cos(alpha)*g*m,MaxC9+MaxC7],0)-vget([MaxC12,FRy,MaxC13],0)*vget([-b,-d,MaxC10],1)+vget([MaxC12,FRy,MaxC13],1)*vget([-b,-d,MaxC10],0)= MaxC15,vget([abs(sin(alpha))*g*m+MaxC6,MaxC8-cos(alpha)*g*m,MaxC9+MaxC7],0)+vget([MaxC12,FRy,MaxC13],0)+vget([FKx,FKy,MaxC14],0)= MaxC16,vget([abs(sin(alpha))*g*m+MaxC6,MaxC8-cos(alpha)*g*m,MaxC9+MaxC7],1)+vget([MaxC12,FRy,MaxC13],1)+vget([FKx,FKy,MaxC14],1)= MaxC17],[FRy,FKx,FKy],FRy)";FTabs:abs(sin(alpha))*g*m;FTvec:[abs(sin(alpha))*g*m,0N,0N];M0:[0Nm,0Nm,0Nm];equFx:vget([abs(sin(alpha))*g*m+0N,0N-cos(alpha)*g*m,0N+0N],0)+vget([0N,FRy,0N],0)+vget([FKx,FKy,0N],0)=0N;equFy:vget([abs(sin(alpha))*g*m+0N,0N-cos(alpha)*g*m,0N+0N],1)+vget([0N,FRy,0N],1)+vget([FKx,FKy,0N],1)=0N;equMz:vget([-b-a,c-d,0m],0)*vget([abs(sin(alpha))*g*m+0N,0N-cos(alpha)*g*m,0N+0N],1)-vget([-b-a,c-d,0m],1)*vget([abs(sin(alpha))*g*m+0N,0N-cos(alpha)*g*m,0N+0N],0)-vget([0N,FRy,0N],0)*vget([-b,-d,0m],1)+vget([0N,FRy,0N],1)*vget([-b,-d,0m],0)=0Nm;rGvec:[-b-a,c-d,0m];rRvec:[-b,-d,0m];]]></maximaAngabe>
