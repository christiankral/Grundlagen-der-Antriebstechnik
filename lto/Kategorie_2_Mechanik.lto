            <maxima><![CDATA[// Kraftvektor F1
F1x : F1abs * cos(alpha)
F1y : F1abs * sin(alpha)
F1vec : [F1x, F1y, 0N]
F1abs : vabs(F1vec)

// Kraftvektor F2
F2y : -F1y
F2x : sqrt(F2abs^2 - F2y^2)
F2vec : [F2x, F2y, 0N]
beta : atan2(F2y, F2x)


// Widerstsandskraft
FWvec : -F1vec - F2vec
FWabs : vabs(FWvec)
]]></maxima>
