F2abs : vabs(F2vec)

F3vec : [F3x, F3y, 0N]
alpha3 : atan2(F3y, F3x)
F3abs : vabs(F3vec)

F4vec : [F4x, F4y, 0N]
alpha4 : atan2(F4y, F4x)
F4abs : vabs(F4vec)
]]></maxima>
            <maximaAngabe><![CDATA[MaxC0:0N;MaxC1:0N;MaxC2:0N;MaxC3:0N;;::;F1abs:vabs([F1x,F1y,0N]);F1vec:[F1x,F1y,0N];F2abs:vabs([F2x,F2y,0N]);F2vec:[F2x,F2y,0N];F3abs:vabs([F3x,F3y,0N]);F3vec:[F3x,F3y,0N];F4abs:vabs([F4x,F4y,0N]);F4vec:[F4x,F4y,0N];alpha1:atan2(F1y,F1x);alpha2:atan2(F2y,F2x);alpha3:atan2(F3y,F3x);alpha4:atan2(F4y,F4x);]]></maximaAngabe>
