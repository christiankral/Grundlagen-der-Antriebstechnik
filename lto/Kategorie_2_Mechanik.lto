            <maxima><![CDATA[F1vec : [F1x, F1y, 0N]
F1abs : vabs(F1vec)
argF1 : atan2(F1y, F1x)

F2vec : [F2x, F2y, 0N]
F2abs : vabs(F2vec)
argF2 : atan2(F2y, F2x)
gk2 : wenn(F2x > 0N, "größer", "kleiner")

Fvec : F1vec + F2vec
Fabs : vabs(Fvec)
Fx : vget(Fvec, 0)
Fy : vget(Fvec, 1)
Fz : vget(Fvec, 2)
argF : atan2(Fy, Fx)
gk : wenn(Fx > 0N, "größer", "kleiner")]]></maxima>
