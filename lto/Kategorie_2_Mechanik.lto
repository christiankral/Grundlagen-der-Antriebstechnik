            <dataset>
               <id>157656153</id>
               <status><![CDATA[shared]]></status>
               <name><![CDATA[m]]></name>
               <type><![CDATA[calculated]]></type>
               <distribution><![CDATA[uniform]]></distribution>
               <minimum><![CDATA[1530]]></minimum>
               <maximum><![CDATA[2380]]></maximum>
               <decimals><![CDATA[0]]></decimals>
               <itemcount>40</itemcount>
               <zahlenbereich><![CDATA[F3:1400-2500]]></zahlenbereich>
