            <idUser>1836</idUser>
            <questionType>22</questionType>
            <single>2</single>
            <name><![CDATA[Musterbeispiel Freischneiden]]></name>
            <punkte>11.0</punkte>
            <penalty/>
            <hidden>0</hidden>
            <tag/>
            <noAutoCorrect>0</noAutoCorrect>
            <usecase>0</usecase>
            <synchronize>0</synchronize>
            <shuffleAnswers>1</shuffleAnswers>
            <answerNumbering><![CDATA[abc]]></answerNumbering>
            <unitGradingType>2</unitGradingType>
            <unitPenalty>0.1</unitPenalty>
            <showUnits>0</showUnits>
            <unitsLeft>0</unitsLeft>
            <maxima><![CDATA[FGabs : m * g
FGvec : [0N, -FGabs, 0N]

F1abs : FGabs / 2 / cos(alpha / 2)
F2abs : F1abs

alpha1 : 90° - alpha / 2
F1x : F1abs * cos(alpha1)
F1y : F1abs * sin(alpha1)
F1vec : [F1x, F1y, 0N]

alpha2 : 90° + alpha / 2
F2x : F2abs * cos(alpha2)
F2y : F2abs * sin(alpha2)
F2vec : [F2x, F2y, 0N]
]]></maxima>
            <responseFormat><![CDATA[editor]]></responseFormat>
