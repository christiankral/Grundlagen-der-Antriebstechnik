            <maxima><![CDATA[// Betrag der Gewichtskraft
FG : m * g
v0vec : [v0, 0'm/s', 0'm/s']

// Rollreibung
FR : mu * FG
FRvec : [-FR, 0N, 0N]

// Tangential-Gewichtskraft
FGT : FG * sin(alpha)
FGTvec : [-FGT, 0N, 0N]

// Normal-Gewichtskraft
FGN : FG * cos(alpha)
FGNvec : [0N, -FGN, 0N]

// Gewichtskraft
FGvec : FGTvec + FGNvec

// Konstante Geschwindigkeit
FA0vec : -FGTvec
P0 : vin(FA0vec, v0vec)

// Traktionskraft (dynamisch mit Beschleunigung a1)
a1vec : [a1, 0'm1s-2', 0'm1s-2']
FA1vec : m * a1vec - FGTvec
t1 : (v1 - v0) / a1

// Beschleunigung ohne Traktionskraft, d.h. FA = 0
a2vec : FGTvec / m
t2 : -v0 / vget(a2vec,0)
]]></maxima>
