            <subquestion>
               <id>157659872</id>
               <grade>1.0</grade>
               <mode>4</mode>
               <name><![CDATA[Q0]]></name>
               <maxima/>
               <plugininfo/>
               <shuffleAnswers>1</shuffleAnswers>
               <schwierigkeit>0</schwierigkeit>
