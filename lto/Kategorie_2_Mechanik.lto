         <question type="MoodleClozeCalc">
            <id>157655799</id>
            <idUser>1830</idUser>
            <questionType>22</questionType>
            <single>2</single>
            <name><![CDATA[Drehmoment]]></name>
            <punkte>4.0</punkte>
            <penalty/>
            <hidden>0</hidden>
            <tag/>
            <noAutoCorrect>0</noAutoCorrect>
            <usecase>0</usecase>
            <synchronize>0</synchronize>
            <shuffleAnswers>1</shuffleAnswers>
            <answerNumbering><![CDATA[abc]]></answerNumbering>
            <unitGradingType>2</unitGradingType>
            <unitPenalty>0.1</unitPenalty>
            <showUnits>0</showUnits>
            <unitsLeft>0</unitsLeft>
            <maxima><![CDATA[// Abstandsvektor
rx : rlen * cos(rarg)
ry : rlen * sin(rarg)

// Kraftvektor
f : sqrt(fx^2 + fy^2)
angle : atan2(fy,fx)
Fvec : Fabs * [fx/f, fy/f, 0]

// Einsvektor der Wirkungslinie der Kraft
ex : fx / f
ey : fy / f

// Scalierung
xmin : ground(min(x, x+rx, x-2*flen, x+rx-2*flen),1)
xmax : xmin + par
ymin : ground(min(y, y+ry, y-2*flen, y+ry-2*flen),1)
ymax : ymin + par

// Zwei Punkte der Wirkungskine
P1x : x + rx - ex * par
P1y : y + ry - ey * par
P2x : x + rx + ex * par
P2y : y + ry + ey * par

rvec : [rx, ry, 0m]
Mvec : vex(rvec,Fvec)
]]></maxima>
            <responseFormat><![CDATA[editor]]></responseFormat>
            <responseFieldLines>10</responseFieldLines>
            <attachments>3</attachments>
            <md5/>
            <units/>
            <plugins><![CDATA[[PI Plugin1 Plot "// Bezugspunkt;point(x,y,tex="\mathcal O",textsize=1.2, bgcolor=white);;// Wirkungslinie;line(P1x,P1y,P2x,P2y,color=white);line(P1x,P1y,P2x,P2y,color=gray,style="-");;// Abstandsvektor;arrow(x,y,x+rx,y+ry,color=darkgreen,tex="\vec r", textsize=1.2, textcolor=darkgreen, bgcolor=white);// Kraftvektor;arrow(x+rx,y+ry,x+rx+ex*flen,y+ry+ey*flen,tex="\vec F",textcolor=blue,textsize=1.2, bgcolor=white);;numbers=all;legend=x;ae;x : xmin, xmax, tex="x";y : ymin, ymax, tex="y""]]]></plugins>
