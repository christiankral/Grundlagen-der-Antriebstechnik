            <maxima><![CDATA[// Betrag der Gewichtskraft
FG : m * g
// Rollreibung
FR : mu * FG
FRvec : [-FR, 0N, 0N]
// Luftreibung
FL : cw * A * rho * v^2 / 2
FLvec : [-FL, 0N, 0N]
// Fahrwiderstand (statisch)
FA0vec : -FRvec -FLvec

// Traktionskraft (dynamisch mit Beschleunigung a1)
a1vec : [a1, 0'm1s-2', 0'm1s-2']
FA1vec : m * a1vec - FRvec - FLvec

// Traktionskraft (dynamisch mit Beschleunigung a1)
a2 : a1 + pm * da
a2vec : [a2, 0'm1s-2', 0'm1s-2']
FA2vec : m * a2vec - FRvec - FLvec

]]></maxima>
