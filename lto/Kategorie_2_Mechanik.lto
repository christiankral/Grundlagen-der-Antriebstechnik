            <unitsLeft>0</unitsLeft>
            <maxima><![CDATA[// Implementierung funktioniert nur mit MAXIMA, nicht mit Parser
// vexz(r, F) := r[1] * F[2] - r[2] * F[1]
vexz(r, F) := vget(r,0) * vget(F,1) - vget(r,1) * vget(F,0)

// Null-Vektoren
M0 : [0Nm, 0Nm, 0Nm]
F0 : [0N, 0N, 0N]

// Beträge der Kräfte
FGabs : m * g
FNabs : FGabs * cos(alpha)
FTabs : FGabs * abs(sin(alpha))

// Kraftvektoren der Gewichtskraft
FNvec : [0N, -FNabs, 0N]
FTvec : [-FTabs, 0N, 0N]
FGvec : FNvec + FTvec

// Abstsandsvektoren
rVvec : [a + b, 0m, 0m]
rGvec : [a, c, 0m]

// Kraftvektoren
FVvec : [0N, FVy, 0N]
FHvec : [FHx, FHy, 0N]

// Drehmomentgleichung erfordert Maxima statt Parser
equMz : vexz(rGvec,FGvec) + vexz(rVvec, FVvec) = 0Nm
// Kraftgleichung
equFx : vget(FVvec,0) + vget(FHvec,0) + vget(FGvec,0) = 0N
equFy : vget(FVvec,1) + vget(FHvec,1) + vget(FGvec,1) = 0N

// FHy : solvevalue(equMz, [FHy], [FHy])
FVysol : solvevalue([equMz, equFx, equFy], [FVy, FHx, FHy], FVy)
FHxsol : solvevalue([equMz, equFx, equFy], [FVy, FHx, FHy], FHx)
FHysol : solvevalue([equMz, equFx, equFy], [FVy, FHx, FHy], FHy)

// Rückeinsetzen in Vektoren
FVvec : ev(FVvec, FVy = FVysol)
FHvec : ev(FHvec, FHx = FHxsol, FHy = FHysol)
]]></maxima>
            <maximaAngabe><![CDATA[MaxC0:0Nm;MaxC1:0Nm;MaxC10:0m;MaxC11:0m;MaxC12:0m;MaxC13:0N;MaxC14:0N;MaxC15:0N;MaxC16:0Nm;MaxC17:0N;MaxC18:0N;MaxC2:0Nm;MaxC3:0N;MaxC4:0N;MaxC5:0N;MaxC6:0N;MaxC7:0N;MaxC8:0N;MaxC9:0N;;::;F0:[0N,0N,0N];FGabs:g*m;FGvec:[0N-abs(sin(alpha))*g*m,0N-cos(alpha)*g*m,0N+0N];FHvec:"[solvevalue([vget([a,c,MaxC12],0)*vget([MaxC6-abs(sin(alpha))*g*m,MaxC8-cos(alpha)*g*m,MaxC9+MaxC7],1)-vget([a,c,MaxC12],1)*vget([MaxC6-abs(sin(alpha))*g*m,MaxC8-cos(alpha)*g*m,MaxC9+MaxC7],0)-vget([MaxC13,FVy,MaxC14],0)*vget([b+a,MaxC10,MaxC11],1)+vget([MaxC13,FVy,MaxC14],1)*vget([b+a,MaxC10,MaxC11],0)= MaxC16,vget([MaxC6-abs(sin(alpha))*g*m,MaxC8-cos(alpha)*g*m,MaxC9+MaxC7],0)+vget([MaxC13,FVy,MaxC14],0)+vget([FHx,FHy,MaxC15],0)= MaxC17,vget([MaxC6-abs(sin(alpha))*g*m,MaxC8-cos(alpha)*g*m,MaxC9+MaxC7],1)+vget([MaxC13,FVy,MaxC14],1)+vget([FHx,FHy,MaxC15],1)= MaxC18],[FVy,FHx,FHy],FHx),solvevalue([vget([a,c,MaxC12],0)*vget([MaxC6-abs(sin(alpha))*g*m,MaxC8-cos(alpha)*g*m,MaxC9+MaxC7],1)-vget([a,c,MaxC12],1)*vget([MaxC6-abs(sin(alpha))*g*m,MaxC8-cos(alpha)*g*m,MaxC9+MaxC7],0)-vget([MaxC13,FVy,MaxC14],0)*vget([b+a,MaxC10,MaxC11],1)+vget([MaxC13,FVy,MaxC14],1)*vget([b+a,MaxC10,MaxC11],0)= MaxC16,vget([MaxC6-abs(sin(alpha))*g*m,MaxC8-cos(alpha)*g*m,MaxC9+MaxC7],0)+vget([MaxC13,FVy,MaxC14],0)+vget([FHx,FHy,MaxC15],0)= MaxC17,vget([MaxC6-abs(sin(alpha))*g*m,MaxC8-cos(alpha)*g*m,MaxC9+MaxC7],1)+vget([MaxC13,FVy,MaxC14],1)+vget([FHx,FHy,MaxC15],1)= MaxC18],[FVy,FHx,FHy],FHy),MaxC15]";FHxsol:"solvevalue([vget([a,c,MaxC12],0)*vget([MaxC6-abs(sin(alpha))*g*m,MaxC8-cos(alpha)*g*m,MaxC9+MaxC7],1)-vget([a,c,MaxC12],1)*vget([MaxC6-abs(sin(alpha))*g*m,MaxC8-cos(alpha)*g*m,MaxC9+MaxC7],0)-vget([MaxC13,FVy,MaxC14],0)*vget([b+a,MaxC10,MaxC11],1)+vget([MaxC13,FVy,MaxC14],1)*vget([b+a,MaxC10,MaxC11],0)= MaxC16,vget([MaxC6-abs(sin(alpha))*g*m,MaxC8-cos(alpha)*g*m,MaxC9+MaxC7],0)+vget([MaxC13,FVy,MaxC14],0)+vget([FHx,FHy,MaxC15],0)= MaxC17,vget([MaxC6-abs(sin(alpha))*g*m,MaxC8-cos(alpha)*g*m,MaxC9+MaxC7],1)+vget([MaxC13,FVy,MaxC14],1)+vget([FHx,FHy,MaxC15],1)= MaxC18],[FVy,FHx,FHy],FHx)";FHysol:"solvevalue([vget([a,c,MaxC12],0)*vget([MaxC6-abs(sin(alpha))*g*m,MaxC8-cos(alpha)*g*m,MaxC9+MaxC7],1)-vget([a,c,MaxC12],1)*vget([MaxC6-abs(sin(alpha))*g*m,MaxC8-cos(alpha)*g*m,MaxC9+MaxC7],0)-vget([MaxC13,FVy,MaxC14],0)*vget([b+a,MaxC10,MaxC11],1)+vget([MaxC13,FVy,MaxC14],1)*vget([b+a,MaxC10,MaxC11],0)= MaxC16,vget([MaxC6-abs(sin(alpha))*g*m,MaxC8-cos(alpha)*g*m,MaxC9+MaxC7],0)+vget([MaxC13,FVy,MaxC14],0)+vget([FHx,FHy,MaxC15],0)= MaxC17,vget([MaxC6-abs(sin(alpha))*g*m,MaxC8-cos(alpha)*g*m,MaxC9+MaxC7],1)+vget([MaxC13,FVy,MaxC14],1)+vget([FHx,FHy,MaxC15],1)= MaxC18],[FVy,FHx,FHy],FHy)";FNabs:cos(alpha)*g*m;FNvec:[0N,-(cos(alpha)*g*m),0N];FTabs:abs(sin(alpha))*g*m;FTvec:[-(abs(sin(alpha))*g*m),0N,0N];FVvec:"[MaxC13,solvevalue([vget([a,c,MaxC12],0)*vget([MaxC6-abs(sin(alpha))*g*m,MaxC8-cos(alpha)*g*m,MaxC9+MaxC7],1)-vget([a,c,MaxC12],1)*vget([MaxC6-abs(sin(alpha))*g*m,MaxC8-cos(alpha)*g*m,MaxC9+MaxC7],0)-vget([MaxC13,FVy,MaxC14],0)*vget([b+a,MaxC10,MaxC11],1)+vget([MaxC13,FVy,MaxC14],1)*vget([b+a,MaxC10,MaxC11],0)= MaxC16,vget([MaxC6-abs(sin(alpha))*g*m,MaxC8-cos(alpha)*g*m,MaxC9+MaxC7],0)+vget([MaxC13,FVy,MaxC14],0)+vget([FHx,FHy,MaxC15],0)= MaxC17,vget([MaxC6-abs(sin(alpha))*g*m,MaxC8-cos(alpha)*g*m,MaxC9+MaxC7],1)+vget([MaxC13,FVy,MaxC14],1)+vget([FHx,FHy,MaxC15],1)= MaxC18],[FVy,FHx,FHy],FVy),MaxC14]";FVysol:"solvevalue([vget([a,c,MaxC12],0)*vget([MaxC6-abs(sin(alpha))*g*m,MaxC8-cos(alpha)*g*m,MaxC9+MaxC7],1)-vget([a,c,MaxC12],1)*vget([MaxC6-abs(sin(alpha))*g*m,MaxC8-cos(alpha)*g*m,MaxC9+MaxC7],0)-vget([MaxC13,FVy,MaxC14],0)*vget([b+a,MaxC10,MaxC11],1)+vget([MaxC13,FVy,MaxC14],1)*vget([b+a,MaxC10,MaxC11],0)= MaxC16,vget([MaxC6-abs(sin(alpha))*g*m,MaxC8-cos(alpha)*g*m,MaxC9+MaxC7],0)+vget([MaxC13,FVy,MaxC14],0)+vget([FHx,FHy,MaxC15],0)= MaxC17,vget([MaxC6-abs(sin(alpha))*g*m,MaxC8-cos(alpha)*g*m,MaxC9+MaxC7],1)+vget([MaxC13,FVy,MaxC14],1)+vget([FHx,FHy,Ma