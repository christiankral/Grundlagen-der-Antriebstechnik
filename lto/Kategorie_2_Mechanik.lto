            <maxima><![CDATA[// Kraftvektor
f : sqrt(fx^2 + fy^2)
angle : atan2(fy,fx)
Fvec : Fabs * [fx/f, fy/f, 0]

// Einsvektor der Wirkungslinie der Kraft
ex : fx / f
ey : fy / f

// Scalierung
xmin : ground(min(x, x+rx, x-2*flen, x+rx-2*flen),1)
xmax : xmin + par
ymin : ground(min(y, y+ry, y-2*flen, y+ry-2*flen),1)
ymax : ymin + par

// Zwei Punkte der Wirkungskine
P1x : x + rx - ex * par
P1y : y + ry - ey * par
P2x : x + rx + ex * par
P2y : y + ry + ey * par

rvec : [rx, ry, 0m]
Mvec : vex(rvec,Fvec)
]]></maxima>
            <responseFormat><![CDATA[editor]]></responseFormat>
            <responseFieldLines>10</responseFieldLines>
            <attachments>3</attachments>
