            <maxima><![CDATA[// Maximale Kraft 
Fmax : (m1 + m2) * a1
Fmaxvec : [Fmax, 0N, 0N]

// Vektoren der Geschwindigkeiten und Beschleunigungen
a1vec : [a1, 0'm1s-2', 0'm1s-2']
a2vec : [a2, 0'm1s-2', 0'm1s-2']
v1vec : [v1, 0'm1s-1', 0'm1s-1']
v2vec : [v2, 0'm1s-1', 0'm1s-1']

// Konfiguration a
FA1vec : m1 * a1vec
t1 : v1 / a1
t2 : (v1 - v2) / a1

a2vec : [a2, 0'm1s-2', 0'm1s-2']
]]></maxima>
