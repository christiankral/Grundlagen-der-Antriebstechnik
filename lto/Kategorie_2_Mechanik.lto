            <maxima><![CDATA[F2x : -F1x + dF2x

// Koordinaten Vektor F1 mit Anfangs (a) und End (e) Punkt
F1ax : -F1x
F1ay : -F1y
F1ex : 0
F1ey : 0

// Kenngrößen Vektor F1
// Steigung
k1 : (F1ey - F1ay) / (F1ex - F1ax)
// Schnittpunkt mit vertikaler Achse
d1 : F1ay - k1 * F1ax
// Winkel
angle1 : atan2(F1ey - F1ay, F1ex - F1ax)

// Koordinaten Vektor F2 mit Anfangs (a) und End (e) Punkt
F2ax : 0
F2ay : 0
F2ex : F2x
F2ey : F2y

// Kenngrößen Vektor F2
// Steigung
k2 : (F2ey - F2ay) / (F2ex - F2ax)
// Schnittpunkt mit vertikaler Achse
d2 : F2ay - k2 * F2ax
// Winkel
angle2 : atan2(F2ey - F2ay, F2ex - F2ax)

// Summenkraft
Fsumx : F1x + F2x
Fsumy : F1y + F2y

// Kenngrößen der Summenkraft
Fsum : sqrt(Fsumx^2 + Fsumy^2)
ksum : (F1y + F2y) / (F1x + F2x)
dsum : d1 + d2
anglesum : atan2(Fsumy, Fsumx)

// Eingegebene Punkte
Q1x : pvgetx(Q0, 0)
Q1y : pvgety(Q0, 0)
Q2x : pvgetx(Q0, 1)
Q2y : pvgety(Q0, 1)

Qk : (Q2y - Q1y) / (Q2x - Q1x) 
Qlen : sqrt((Q2y - Q1y)^2 + (Q2x - Q1x)^2) 
Qd : Q1y - Qk * Q1x
Qangle : atan2(Q2y - Q1y, Q2x - Q1x)

erg : [[0N, 0N], [Fsumx, Fsumy]]
]]></maxima>
