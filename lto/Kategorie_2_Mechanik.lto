         <question type="MoodleClozeCalc">
            <id>157653924</id>
            <idUser>1836</idUser>
            <questionType>22</questionType>
            <single>2</single>
            <name><![CDATA[Addition grafisch 3]]></name>
            <punkte>1.0</punkte>
            <penalty/>
            <hidden>0</hidden>
            <tag/>
            <noAutoCorrect>0</noAutoCorrect>
            <usecase>0</usecase>
            <synchronize>0</synchronize>
