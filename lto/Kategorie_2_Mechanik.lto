            <maxima><![CDATA[// Zentrischen Bohrungslöcher
R : (d + D) / 2
x : d - 2 * dx

// Trägheitsmoment des langen Hohlzylinders mit der Länge (L-l)
m : (d^2-x^2)*%pi/4*(L-l)*rho
J1 : m/2 * ((d/2)^2+(x/2)^2)

// Trägheitsmoment einer Bohrung (Vollzylinder)
mB : y^2*%pi/4*l*rho
JB1 : mB/2 *(y/2)^2

// Satz von Steiner 
JB : JB1 + mB * R^2

// Trägheitsmoment des Flansches ohne Bohrung
m2 : (D^2-x^2)*%pi/4*l*rho
J2 : m2/2 * ((D/2)^2+(x/2)^2)

// Trägheitsmoment des Flansches mit Bohrung
J3 : J2 - JB *4

Jges : J1 + J2 - JB *4]]></maxima>
            <maximaAngabe><![CDATA[;::;J1:%pi*(d^2-(d-2*dx)^2)*((d-2*dx)^2/4+d^2/4)*rho*(L-l)/8;J2:%pi*l*rho*(D^2/4+(d-2*dx)^2/4)*(D^2-(d-2*dx)^2)/8;J3:%pi*l*rho*(D^2/4+(d-2*dx)^2/4)*(D^2-(d-2*dx)^2)/8-4*(%pi*l*rho*y^2*(D+d)^2/16+%pi*l*rho*y^4/32);JB:%pi*l*rho*y^2*(D+d)^2/16+%pi*l*rho*y^4/32;JB1:%pi*l*rho*y^4/32;Jges:%pi*(d^2-(d-2*dx)^2)*((d-2*dx)^2/4+d^2/4)*rho*(L-l)/8+4*(-%pi*l*rho*y^2*(D+d)^2/16-%pi*l*rho*y^4/32)+%pi*l*rho*(D^2/4+(d-2*dx)^2/4)*(D^2-(d-2*dx)^2)/8;R:(D+d)/2;m:%pi*(d^2-(d-2*dx)^2)*rho*(L-l)/4;m2:%pi*l*rho*(D^2-(d-2*dx)^2)/4;mB:%pi*l*rho*y^2/4;x:d-2*dx;]]></maximaAngabe>
