            <unitPenalty>0.1</unitPenalty>
            <showUnits>0</showUnits>
            <unitsLeft>0</unitsLeft>
            <maxima><![CDATA[// Nullvektor
N0 : [0N, 0N, 0N]
// Gewichtskraft
FGabs : m1 * g
FGvec : [0N, -FGabs, 0N]

// Normalkraft
FNabs : FGabs
FNvec : -FGvec

// FALL 1
// Kraft F1
F1abs : k1 * mu * FNabs
F1x : -F1abs
F1vec : [F1x, 0N, 0N]
// Haftreibungskraft
FH1vec : -F1vec
// Maximale Haftreibungskraft
FH1max : mu * FNabs

// FALL 2
// Kraft F2
F2x : -F1abs * cos(alpha)
F2y : -F1abs * sin(alpha)
F2vec : [F2x, F2y, 0N]

// Haftreibungskraft, Fall 2
FH2x : -F2x
FH2vec : [FH2x, 0N, 0N]

// Normalkraft
FN2y : m1 * g - F2y
FN2vec : [0N, FN2y, 0N]
FH2max : mu * FN2y]]></maxima>
